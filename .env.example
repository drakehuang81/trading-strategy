# Copy to `.env` and fill in. `.env` is gitignored.
#
# Telegram bot:
#   1. Talk to @BotFather on Telegram → /newbot → follow prompts
#      → save the token shown (looks like 123456789:ABC-DEF...)
#   2. Talk to @userinfobot on Telegram → it replies with your numeric chat ID
#   3. Set both below
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SQLite (default OK for local dev)
SQLITE_PATH=data/state.db
